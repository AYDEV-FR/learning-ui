---
// Global styles bundled into the static build (no external CDNs).
import '../styles/global.css';
import 'highlight.js/styles/github-dark.css';
import '@xterm/xterm/css/xterm.css';

interface Props {
  title?: string;
}

const { title = 'Training Environment' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
